# ─────────────────────────────────────────────────────────────────────────────
# PDA Companion – environment configuration
# Copy to .env.local and fill in. With everything left blank the app runs in
# DEMO MODE: local browser storage, rule-based demo responses, no external calls.
# Never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI provider ──────────────────────────────────────────────────────────────
# AI_PROVIDER: anthropic | openai | mock
# Leave blank to auto-select: anthropic if ANTHROPIC_API_KEY is set, otherwise
# openai if OPENAI_API_KEY is set, otherwise mock (demo responses).
AI_PROVIDER=
# AI_MODEL: optional model override for the selected provider.
# Defaults: anthropic → claude-opus-5-5, openai → gpt-4o
AI_MODEL=
# AI_EFFORT (Anthropic only): low | medium | high. Default: medium.
AI_EFFORT=
# AI_TIMEOUT_MS: per-request timeout for AI calls. Default: 45000.
AI_TIMEOUT_MS=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Voice transcription (OpenAI) ─────────────────────────────────────────────
# Requires OPENAI_API_KEY. Default model: gpt-4o-mini-transcribe
OPENAI_TRANSCRIPTION_MODEL=

# ── Knowledge retrieval ──────────────────────────────────────────────────────
# KNOWLEDGE_RETRIEVAL: keyword (default, bundled articles) | vector (pgvector
# via Supabase + OpenAI embeddings; run `npm run seed:knowledge` first).
KNOWLEDGE_RETRIEVAL=
OPENAI_EMBEDDING_MODEL=

# ── Supabase ─────────────────────────────────────────────────────────────────
# When both NEXT_PUBLIC_* values are set the app uses Supabase Auth + Postgres.
# When blank the app uses a local demo session and browser storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used solely for account deletion and knowledge seeding.
# NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Misc ─────────────────────────────────────────────────────────────────────
# Requests per minute per user/IP for AI endpoints. Default: 20.
RATE_LIMIT_PER_MINUTE=
# LOG_LEVEL: debug | info | warn | error. Default: info.
LOG_LEVEL=
